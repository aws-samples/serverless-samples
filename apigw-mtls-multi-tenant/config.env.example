# config.env — Fill in your values and save as config.env
# This file is sourced by the deploy/test/teardown scripts.

# Your custom domain name (must match the ACM certificate)
DOMAIN_NAME="your-domain-name.com"

# Route 53 Hosted Zone ID for the domain above
HOSTED_ZONE_ID="<your hosted zone ID here>"

# ACM certificate ARN for the custom domain (server-side TLS)
# This must be a publicly-trusted cert (ACM-issued or imported) for your domain.
CERTIFICATE_ARN="<your certificate ARN here>"

# S3 bucket name for the truststore PEM (will be created if it doesn't exist)
TRUSTSTORE_BUCKET="your trustore unique bucket name here"

# CloudFormation stack name
STACK_NAME="apigw-mtls-demo"

# AWS region
AWS_REGION="us-east-1"
